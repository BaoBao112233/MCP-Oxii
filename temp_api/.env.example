# MCP-Oxii Temp API Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
API_VERSION=v1
APP_NAME=Planner API
APP_DESC=API for managing plans and tasks
HOST_PORT=8000
CONTAINER_NAME=mcp-planner-api

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
DEBUG_MODE=true
LOG_LEVEL=INFO
CORS_ORIGINS=*

# =============================================================================
# DOCKER SETTINGS
# =============================================================================
DOCKERFILE=Dockerfile
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# =============================================================================
# RESOURCE LIMITS
# =============================================================================
CPU_LIMIT=1.0
MEMORY_LIMIT=512M
CPU_RESERVATION=0.5
MEMORY_RESERVATION=256M

# =============================================================================
# VOLUME SETTINGS
# =============================================================================
DATA_VOLUME=./data
LOG_VOLUME=./logs

# =============================================================================
# OPTIONAL SERVICES (when using profiles)
# =============================================================================

# Redis Cache Settings (use with --profile with-cache)
REDIS_PORT=6379

# PostgreSQL Database Settings (use with --profile with-db)
POSTGRES_PORT=5432
POSTGRES_DB=planner_db
POSTGRES_USER=planner_user
POSTGRES_PASSWORD=planner_pass

# Database connection string (if using external DB)
DATABASE_URL=sqlite:///./data/plans.db

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and adjust for production deployment

# DEBUG_MODE=false
# LOG_LEVEL=WARNING
# CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# HOST_PORT=80
# CPU_LIMIT=2.0
# MEMORY_LIMIT=1G